# Configuraciones para el directorio de imágenes
php_value upload_max_filesize 10M
php_value post_max_size 10M
php_value max_execution_time 300
php_value max_input_time 300
php_value memory_limit 256M

# Permitir acceso directo a imágenes
<Files "*.jpg">
    Order Allow,Deny
    Allow from all
</Files>
<Files "*.jpeg">
    Order Allow,Deny
    Allow from all
</Files>
<Files "*.png">
    Order Allow,Deny
    Allow from all
</Files>
<Files "*.gif">
    Order Allow,Deny
    Allow from all
</Files>
<Files "*.webp">
    Order Allow,Deny
    Allow from all
</Files>

